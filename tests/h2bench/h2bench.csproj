<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- A benchmark built in Debug measures the debugger, not the stack.
         Release is the default here so "dotnet run" reports something real;
         the harness still warns at startup if it finds itself in Debug. -->
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\Hermod\Hermod\Hermod.csproj" />
    <ProjectReference Include="..\..\libs\Styx\Styx\Styx.csproj" />
  </ItemGroup>

</Project>
